{
  "openapi": "3.1.1",
  "info": {
    "title": "CryptoApi | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7164"
    },
    {
      "url": "http://localhost:5153"
    }
  ],
  "paths": {
    "/api/Crypto": {
      "get": {
        "tags": [
          "Crypto"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/GetCryptoPricesResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCryptoPricesResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCryptoPricesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CryptoPriceItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "priceUsd": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "lastUpdatedUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GetCryptoPricesResponse": {
        "type": "object",
        "properties": {
          "prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CryptoPriceItem"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Crypto"
    }
  ]
}